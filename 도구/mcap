#!/bin/zsh
# mcap — iPhone 미러링 창을 레티나 해상도로 캡처 (phone-harness와 함께 사용)
# 사용법: mcap <앱이름> [화면이름]   예) mcap 영업비서 고객상세  →  ~/Desktop/앱캡처/영업비서/m01_고객상세.png
ROOT="${ICAP_ROOT:-$HOME/Desktop/앱캡처}"
[[ -z "$1" ]] && { echo "사용법: mcap <앱이름> [화면이름]"; exit 1; }
APP="$1"; NAME="${2:-screen}"
DIR="$ROOT/$APP"; [[ "$APP" == "영업비서" && -z "$ICAP_ROOT" ]] && DIR="$HOME/영업비서/고객메뉴_분석"; mkdir -p "$DIR"
WID=$("$HOME/.local/share/uv/tools/phone-harness/bin/python" - <<'PY'
import Quartz
for w in Quartz.CGWindowListCopyWindowInfo(Quartz.kCGWindowListOptionOnScreenOnly, Quartz.kCGNullWindowID):
    if w.get("kCGWindowOwnerName") in ("iPhone Mirroring", "iPhone 미러링") and w.get("kCGWindowLayer") == 0:
        print(w["kCGWindowNumber"]); break
PY
)
[[ -z "$WID" ]] && { echo "❌ iPhone 미러링 창을 찾지 못했습니다"; exit 1; }
EXIST=( "$DIR"/m[0-9][0-9]_*.png(N) )
OUT="$DIR/m$(printf '%02d' $(( ${#EXIST} + 1 )))_${NAME// /_}.png"
screencapture -x -o -l "$WID" "$OUT" && echo "✅ $OUT" && sips -g pixelWidth -g pixelHeight "$OUT" | awk '/pixel/{printf "   %s %s\n",$1,$2}'
